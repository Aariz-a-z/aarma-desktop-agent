__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- virtual environments -----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- tooling ------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
